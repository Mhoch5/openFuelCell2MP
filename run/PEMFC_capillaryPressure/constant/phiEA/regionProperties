FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          cellProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//- Add information here

sigma
{
    bpp
    {
        sigmaModel      constantSigma;

        constantSigmaCoeffs
        {
            cellZone    bpp;
            sigma       20000;
        }
    }

    acl
    {
        sigmaModel      porousSigma;

        porousSigmaCoeffs
        {
            cellZone        acl;
            catalyst        no;
            porosity        0.3;
            sigma           5000;
        }
    }

    ampl
    {
        sigmaModel      resistanceSigma;

        resistanceSigmaCoeffs
        {
            cellZone        ampl;
            catalyst        no;
            //porosity        0.4;
            //sigma           8000;
            thickness       0.2e-4;
            resistance      0.56e-7;
        }
    }

    anode
    {
        sigmaModel      resistanceSigma;

        resistanceSigmaCoeffs
        {
            cellZone        anode;
            catalyst        no;
            //porosity        0.7;
            //sigma           8000;
            thickness       2.3e-4;
            resistance      6.44e-7;
        }
    }
}
