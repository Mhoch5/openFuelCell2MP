FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "1/phiI/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    cathodeSides
    {
        type            patch;
        nFaces          600;
        startFace       46000;
    }
    electrolyteSides
    {
        type            patch;
        nFaces          1200;
        startFace       46600;
    }
    anodeSides
    {
        type            patch;
        nFaces          600;
        startFace       47800;
    }
    phiI_to_phiI0
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          1600;
        startFace       48400;
        sampleMode      nearestPatchFace;
        sampleRegion    phiI0;
        samplePatch     phiI0_to_phiI;
    }
)

