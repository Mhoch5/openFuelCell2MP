FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       decomposedBlockData;
    object      iDmdtair.H2O;
    data.format     ascii;
    data.class      volScalarField;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// processor0

897
(FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "1.5/air";
    object      iDmdtair.H2O;
}
dimensions      [1 -3 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    airInlet
    {
        type            calculated;
        value           uniform 0;
    }
    airOutlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    cathodeSides
    {
        type            calculated;
        value           uniform 0;
    }
    air_to_interconnect
    {
        type            calculated;
        value           uniform 0;
    }
    air_to_electrolyte
    {
        type            calculated;
        value           uniform 0;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 0;
    }
}
)

