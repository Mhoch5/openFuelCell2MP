FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       decomposedBlockData;
    object      diffSp.N2;
    data.format     ascii;
    data.class      volScalarField;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// processor0

716
(FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "1/air";
    object      diffSp.N2;
}
dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-15;

boundaryField
{
    airInlet
    {
        type            zeroGradient;
    }
    airOutlet
    {
        type            zeroGradient;
    }
    cathodeSides
    {
        type            zeroGradient;
    }
    air_to_interconnect
    {
        type            zeroGradient;
    }
    air_to_electrolyte
    {
        type            zeroGradient;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 1e-15;
    }
}
)

