FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       decomposedBlockData;
    location    "0/air";
    object      U.water;
    data.format ascii;
    data.class  volVectorField;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// processor0

980
(FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/air";
    object      U.water;
}
dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    airInlet
    {
        type            fixedValue;
        value           uniform (5.82 0 0);
    }
    airOutlet
    {
        type            pressureInletOutletVelocity;
        phi             phi.water;
        value           nonuniform List<vector> 0();
    }
    cathodeSides
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    air_to_interconnect
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    air_to_electrolyte
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform (0 0 0);
    }
}
)

