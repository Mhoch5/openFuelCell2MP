FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       decomposedBlockData;
    location    "0/air";
    object      H2O.air;
    data.format ascii;
    data.class  volScalarField;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// processor0

789
(FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/air";
    object      H2O.air;
}
dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.1743;

boundaryField
{
    airInlet
    {
        type            fixedValue;
        value           uniform 0.1743;
    }
    airOutlet
    {
        type            zeroGradient;
    }
    cathodeSides
    {
        type            zeroGradient;
    }
    air_to_interconnect
    {
        type            zeroGradient;
    }
    air_to_electrolyte
    {
        type            fixedGradient;
        gradient        uniform 0;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 0.1743;
    }
}
)

