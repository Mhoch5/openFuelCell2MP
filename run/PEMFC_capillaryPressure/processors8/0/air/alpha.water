FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       decomposedBlockData;
    location    "0/air";
    object      alpha.water;
    data.format ascii;
    data.class  volScalarField;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// processor0

892
(FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/air";
    object      alpha.water;
}
dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    airInlet
    {
        type            calculated;
        value           uniform 0;
    }
    airOutlet
    {
        type            calculated;
        value           nonuniform List<scalar> 0();
    }
    cathodeSides
    {
        type            calculated;
        value           uniform 0;
    }
    air_to_interconnect
    {
        type            calculated;
        value           uniform 0;
    }
    air_to_electrolyte
    {
        type            calculated;
        value           uniform 0;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 0;
    }
}
)

