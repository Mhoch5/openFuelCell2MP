FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       decomposedBlockData;
    location    "0/air";
    object      T.air;
    data.format ascii;
    data.class  volScalarField;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


// processor0

889
(FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/air";
    object      T.air;
}
dimensions      [0 0 0 1 0 0 0];

internalField   uniform 353.15;

boundaryField
{
    airInlet
    {
        type            fixedValue;
        value           uniform 353.15;
    }
    airOutlet
    {
        type            inletOutlet;
        phi             phi.air;
        inletValue      nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    cathodeSides
    {
        type            zeroGradient;
    }
    air_to_interconnect
    {
        type            zeroGradient;
    }
    air_to_electrolyte
    {
        type            zeroGradient;
    }
    procBoundary0to1
    {
        type            processor;
        value           uniform 353.15;
    }
}
)

